# Base
DATABASE_URI=postgres://collec:change_me@localhost:5432/collec_club
POSTGRES_PASSWORD=change_me
PAYLOAD_SECRET=change_me_minimum_32_characters_long
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Etape 03 - Auth (Cloudflare Turnstile + Resend)
# Turnstile - cles de test Cloudflare pour dev local (toujours valide) :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend - expediteur dev : noreply@mail-devcollec.samuel-lecomte.fr
# En prod, basculer RESEND_FROM_ADDRESS vers noreply@collec-club.fr
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@mail-devcollec.samuel-lecomte.fr
RESEND_FROM_NAME=Collec Club

# Etape 05 - TMDB
TMDB_API_KEY=

# Etape 19 - Analytics (Umami)
# Script URL en local : http://localhost:3002/script.js
# Script URL en production : https://analytics.collec-club.fr/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Variables Docker Compose Umami (optionnel en local)
UMAMI_POSTGRES_PASSWORD=
UMAMI_APP_SECRET=

# Post-V1 - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
